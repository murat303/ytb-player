<!-- The Library as YouTube's tablet app lays it out: on the left a framed list of its parts
     (History, Favorites, Watch later, Liked videos and the account's playlists), on the right
     the chosen one's videos as rows. -->
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="12"
    paddingLeft="20"
    paddingRight="20">

    <PageHeader id="library/header" title="@i18n/app/library" />

    <brls:Box
        width="auto"
        height="auto"
        grow="1.0"
        axis="row"
        paddingBottom="12">

        <brls:Box
            width="290"
            height="auto"
            axis="column"
            paddingTop="8"
            paddingBottom="8"
            paddingLeft="8"
            paddingRight="8"
            cornerRadius="16"
            borderColor="#303030"
            borderThickness="1">

            <brls:ScrollingFrame
                id="library/sections_scroll"
                width="auto"
                grow="1.0">

                <brls:Box
                    id="library/sections"
                    width="auto"
                    height="auto"
                    axis="column" />
            </brls:ScrollingFrame>
        </brls:Box>

        <brls:ScrollingFrame
            id="library/scroll"
            width="auto"
            grow="1.0"
            marginLeft="20">

            <brls:Box
                width="auto"
                height="auto"
                axis="column">

                <brls:Label
                    id="library/body"
                    width="auto"
                    height="auto"
                    lineHeight="1.55"
                    fontSize="17"
                    textColor="#AAAAAA"
                    marginTop="8"
                    marginBottom="12"
                    marginLeft="8"
                    visibility="gone" />

                <brls:ProgressSpinner
                    id="library/spinner"
                    width="auto"
                    height="80"
                    visibility="gone" />

                <brls:Box
                    id="library/grid"
                    width="auto"
                    height="auto"
                    axis="column" />
            </brls:Box>
        </brls:ScrollingFrame>
    </brls:Box>
</brls:Box>
