<!-- Signing in over Wi-Fi: the address to open on a computer or phone, big, in the middle;
     what happens there under it, and whether the cookies came. -->
<brls:AppletFrame
    headerHidden="true"
    footerHidden="false">
    <brls:Box
        width="100%"
        height="100%"
        axis="column"
        justifyContent="center"
        alignItems="center"
        paddingLeft="80"
        paddingRight="80">

        <!-- Something focusable, so that B reaches this screen and nothing behind it. -->
        <brls:Box
            id="wifi/holder"
            width="1"
            height="1"
            focusable="true"
            hideHighlight="true" />

        <brls:Label
            id="wifi/title"
            width="auto"
            height="auto"
            fontSize="30"
            textColor="#FFFFFF"
            marginBottom="24" />

        <brls:Label
            id="wifi/instructions"
            width="auto"
            height="auto"
            fontSize="19"
            horizontalAlign="center"
            textColor="#AAAAAA"
            marginBottom="18" />

        <brls:Label
            id="wifi/address"
            width="auto"
            height="auto"
            fontSize="40"
            singleLine="true"
            textColor="#3EA6FF"
            marginBottom="24" />

        <brls:Label
            id="wifi/explain"
            width="auto"
            height="auto"
            fontSize="17"
            horizontalAlign="center"
            textColor="#AAAAAA"
            marginBottom="28" />

        <brls:Label
            id="wifi/status"
            width="auto"
            height="auto"
            fontSize="20"
            singleLine="true"
            textColor="#F1F1F1" />
    </brls:Box>
</brls:AppletFrame>
